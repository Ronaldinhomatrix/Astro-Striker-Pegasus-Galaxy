[gd_resource type="Resource" format=3]

[gd_resource_collapse_start]

class_name LevelDefaults extends Resource

## Configurações padrão de nível que garantem consistência visual e de gameplay.
## Cada nível carrega esse resource e aplica os valores automaticamente.

# Câmera
@export var camera_fov: float = 56.25
@export var camera_offset_z: float = 33.85669

# Jogador
@export var player_forward_offset: float = -40.0
@export var player_bounce_strength: float = 320.0
@export var player_bounce_damping: float = 15.0

# PathFollower
@export var path_forward_speed: float = 95.0

# Nave
@export var ship_scale: float = 1.5
@export var collider_size: Vector3 = Vector3(5, 2.5, 9)

# ---------------------------------------------------------------------------
# Aplica as configurações padrão ao nível atual
# ---------------------------------------------------------------------------

func apply_to_scene(scene_root: Node3D) -> void:
	## Aplica todas as configurações padrão ao nó raiz do nível.
	
	# Aplica configurações da câmera
	var cam := scene_root.find_camera3d()
	if cam:
		cam.fov = camera_fov
		# Ajusta offset Z (distância da câmera ao longo do eixo Z local)
		# O offset é calculado baseado no PathFollower/Player position
		# Este valor é aplicado no _ready() do Player
	
	# Aplica configurações do PathFollower
	var path_follower := scene_root.find_path_follower3d()
	if path_follower:
		path_follower.forward_speed = path_forward_speed
	
	# Aplica configurações do Player
	var player := scene_root.find_player()
	if player:
		# Configura colisor
		var col_shape := player.find_collision_shape3d()
		if col_shape and col_shape.shape is BoxShape3D:
			col_shape.shape.size = collider_size
		
		# Configura escala da nave
		var ship_model := player.find_child("ShipModel", true)
		if ship_model:
			ship_model.scale = Vector3(ship_scale, ship_scale, ship_scale)
	
	# Configura física de ricochete
	var bounce_script := player.find_script_by_name("bounce_strength")
	if bounce_script != null:
		# Nota: bounce_strength e bounce_damping são exportados no script player.gd
		# e aplicados via inspector ou configurações de cena
		pass

</gd_resource_collapse_end>